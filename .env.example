DATAFORGE_ENVIRONMENT=development
DATAFORGE_LOG_LEVEL=INFO
DATAFORGE_DATABASE_URL=postgresql+psycopg://dataforge:dataforge@postgres:5432/dataforge
DATAFORGE_REDIS_URL=redis://redis:6379/0
DATAFORGE_CELERY_BROKER_URL=redis://redis:6379/1
DATAFORGE_CELERY_RESULT_BACKEND=redis://redis:6379/2
DATAFORGE_MINIO_ENDPOINT=minio:9000
DATAFORGE_MINIO_ACCESS_KEY=dataforge
DATAFORGE_MINIO_SECRET_KEY=dataforge-dev-password
DATAFORGE_MINIO_SECURE=false
DATAFORGE_MINIO_BUCKET=dataforge
DATAFORGE_MAXIMUM_UPLOAD_SIZE_BYTES=10485760
DATAFORGE_MAXIMUM_ROWS=1000000
DATAFORGE_MAXIMUM_COLUMNS=1000
DATAFORGE_MAXIMUM_REPORT_SIZE_BYTES=5242880
DATAFORGE_JOB_MAX_RETRIES=3
DATAFORGE_RETRY_BASE_SECONDS=2
DATAFORGE_RETRY_MAXIMUM_SECONDS=300
